<Window x:Class="NetworkUsageMonitor.UI.MainFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:NetworkUsageMonitor.UI.Converters"
        mc:Ignorable="d"
        Title="Network Usage Monitor"
        Width="380" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BytesPerSecondConverter x:Key="SpeedConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,14,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Network Usage" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Grid.Column="1" Style="{StaticResource FlyoutButton}"
                        Content="Statistics"
                        Command="{Binding OpenStatisticsCommand}"
                        Background="{StaticResource AccentSoftBrush}"
                        Foreground="{StaticResource AccentBrush}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <Button Command="{Binding ToggleExpandCommand}"
                                        Style="{StaticResource FlyoutButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                            <Border CornerRadius="8"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    Visibility="{Binding IconSource, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding IconSource}"
                                                   Width="24" Height="24"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconSource, Converter={StaticResource NullToVis}}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock FontSize="11" Foreground="{StaticResource DownloadBrush}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding TotalReceivedPerSecond, Converter={StaticResource SpeedConverter}, StringFormat={}&#8595; {0}}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource UploadBrush}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding TotalSentPerSecond, Converter={StaticResource SpeedConverter}, StringFormat={}&#8593; {0}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Children}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                              Margin="42,0,8,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Pid, StringFormat=PID {0}}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding BytesReceivedPerSecond, Converter={StaticResource SpeedConverter}, StringFormat={}&#8595;{0}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="14,8,14,12"
                       Text="Running as Administrator - full process visibility"
                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
        </Grid>
    </Border>
</Window>
