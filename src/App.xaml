<Application x:Class="NetworkUsageMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1D24"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252732"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2E313F"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#363946"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A3B66"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEEF3"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9599AB"/>
        <SolidColorBrush x:Key="UploadBrush" Color="#FF7A59"/>
        <SolidColorBrush x:Key="DownloadBrush" Color="#5FD08A"/>

        <Style x:Key="FlyoutButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>